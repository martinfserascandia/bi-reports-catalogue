# Fabric CI/CD notebook environment variables
# Copy this file to .env and replace placeholder values.

# Required destination workspace for deployment tests (use one identifier)
# For your migration scenario, target should be: konsolidator
# FABRIC_DEST_WORKSPACE_ID=00000000-0000-0000-0000-000000000000
FABRIC_DEST_WORKSPACE_NAME=konsolidator

# Optional source workspace for read-only comparison tests (use one identifier)
# For your migration scenario, source should be: konsolidator_dev
# FABRIC_SOURCE_WORKSPACE_ID=00000000-0000-0000-0000-000000000000
FABRIC_SOURCE_WORKSPACE_NAME=konsolidator_dev

# Required: local path to your Fabric repository directory
FABRIC_REPOSITORY_DIRECTORY=C:\path\to\fabric-repo

# Required: deployment environment label used in parameterization
FABRIC_ENVIRONMENT=MIGRATION

# Required: auth mode for API_test.ipynb
# Allowed values: azure_cli | default | service_principal
FABRIC_AUTH_MODE=azure_cli

# Optional: force isolated Azure CLI cache/profile directory (recommended)
# AZURE_CONFIG_DIR=C:\Users\marti\OneDrive - BioNordic\Desktop\Fabric API\.az-fabric

# Required for azure_cli auth mode (set to the tenant that owns your workspaces)
AZURE_TENANT_ID=92c0e2e5-bda7-4705-a5a9-8b0c90300da0

# Optional: comma-separated item scope for deployments
FABRIC_ITEM_TYPES_SCOPE=Notebook,DataPipeline,Dataflow,Lakehouse,SemanticModel,Report,Environment

# Optional: path to parameter file used during deployment and reference replacement
# FABRIC_PARAMETER_FILE_PATH=C:\Users\marti\OneDrive - BioNordic\Desktop\Fabric API\parameter.yml

# Optional execution switches (safe defaults)
RUN_PUBLISH=false
RUN_UNPUBLISH=false
CONFIRM_UNPUBLISH=false

# Required only when FABRIC_AUTH_MODE=service_principal
AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000
AZURE_CLIENT_SECRET=your-client-secret
